# Normalize line endings to LF in the repo (this deploys to a Linux Pi).
* text=auto eol=lf

# Shell scripts and systemd units must be LF.
*.sh text eol=lf
*.service text eol=lf
*.nft text eol=lf

# PowerShell stays CRLF.
*.ps1 text eol=crlf

# Binary assets — never touch.
*.onnx binary
*.npy binary
*.npz binary
*.joblib binary
*.lgb binary
*.png binary
*.parquet binary
