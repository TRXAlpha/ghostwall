# Ghostwall settings. install.sh copies this to /etc/ghostwall/ghostwall.env and fills in
# what it detects. After editing: sudo bash /opt/ghostwall/agents/ghost_dns/go_shadow.sh
# (DNS settings) or sudo systemctl restart ghostwall-web (dashboard settings).

# Which DNS server Ghostwall watches: adguard or pihole.
DNS_SOURCE=adguard

# AdGuard Home: where it keeps its config and query log, and how to restart it.
# Defaults are for the standard install in /opt/AdGuardHome. Docker example:
#   ADGUARD_YAML=/srv/adguard/conf/AdGuardHome.yaml
#   ADGUARD_QUERYLOG=/srv/adguard/work/data/querylog.json
#   ADGUARD_RESTART="docker restart adguardhome"
ADGUARD_YAML=/opt/AdGuardHome/AdGuardHome.yaml
ADGUARD_QUERYLOG=/opt/AdGuardHome/data/querylog.json
ADGUARD_RESTART="systemctl restart AdGuardHome"
# AdGuard buffers this many queries before writing its log (its default is 1000, which
# can delay alerts by hours). go_shadow.sh lowers it to this value; 0 leaves it alone.
ADGUARD_FLUSH_EVERY=10

# Pi-hole: its query log (native install). Pi-hole in Docker: mount /var/log/pihole
# from the host and point this at <that folder>/pihole.log.
PIHOLE_LOG=/var/log/pihole/pihole.log

# Web dashboard. Any address other than 127.0.0.1 needs the password (user: ghostwall).
# 0.0.0.0 = reachable from your network; a Tailscale IP = only from your tailnet.
GHOSTWALL_WEB_BIND=127.0.0.1
GHOSTWALL_WEB_PASSWORD=
