# Copy to /etc/ghostwall/ghostwall.env (install.sh does this) and edit for your host.

# Where AdGuard Home keeps its config and query log, and how to restart it.
# Defaults are for the standard AdGuard Home install in /opt/AdGuardHome.
ADGUARD_YAML=/opt/AdGuardHome/AdGuardHome.yaml
ADGUARD_QUERYLOG=/opt/AdGuardHome/data/querylog.json
ADGUARD_RESTART="systemctl restart AdGuardHome"
# AdGuard in Docker, for example:
#   ADGUARD_YAML=/srv/adguard/conf/AdGuardHome.yaml
#   ADGUARD_QUERYLOG=/srv/adguard/work/data/querylog.json
#   ADGUARD_RESTART="docker restart adguardhome"

# Address the web dashboard listens on. Keep it private: 127.0.0.1 (use an SSH tunnel)
# or your Tailscale IP. Never a LAN or public address; the dashboard has no login.
GHOSTWALL_WEB_BIND=127.0.0.1
