# Ghostwall settings. install.sh copies this to /etc/ghostwall/ghostwall.env and fills in
# what it detects. After editing: sudo bash /opt/ghostwall/agents/ghost_dns/go_shadow.sh
# (DNS settings) or sudo systemctl restart ghostwall-web (dashboard settings).

# Which DNS server Ghostwall watches: adguard or pihole.
DNS_SOURCE=adguard

# AdGuard Home: where it keeps its config and query log, and how to restart it.
# Defaults are for the standard install in /opt/AdGuardHome. Docker example:
#   ADGUARD_YAML=/srv/adguard/conf/AdGuardHome.yaml
#   ADGUARD_QUERYLOG=/srv/adguard/work/data/querylog.json
#   ADGUARD_RESTART="docker restart adguardhome"
ADGUARD_YAML=/opt/AdGuardHome/AdGuardHome.yaml
ADGUARD_QUERYLOG=/opt/AdGuardHome/data/querylog.json
ADGUARD_RESTART="systemctl restart AdGuardHome"
# AdGuard buffers this many queries before writing its log (its default is 1000, which
# can delay alerts by hours). go_shadow.sh lowers it to this value; 0 leaves it alone.
ADGUARD_FLUSH_EVERY=10

# Pi-hole: its query log (native install). Pi-hole in Docker: mount /var/log/pihole
# from the host and point this at <that folder>/pihole.log.
PIHOLE_LOG=/var/log/pihole/pihole.log

# Web dashboard. Any address other than 127.0.0.1 needs the password (user: ghostwall).
# 0.0.0.0 = reachable from your network; a Tailscale IP = only from your tailnet.
GHOSTWALL_WEB_BIND=127.0.0.1
GHOSTWALL_WEB_PASSWORD=

# Threat feed (update_feed.py, daily). Space-separated https URLs replace the default
# lists (URLhaus, Phishing Army, HaGeZi TIF mini; more with DNS_BLOCK_FEED, see below).
#GHOSTWALL_FEEDS=
# Feed entries that are one of the N most popular domains (Tranco list) are dropped,
# so a list naming a big site cannot block it. 0 keeps only the built-in exclusions.
#GHOSTWALL_FEED_POPULAR_TOP=100000
# How many popular domains to keep (in rank order) in popular_domains.txt for the DGA
# rules' popular-domain guard (ghost-dns's popular_top_n reads the first N of them).
#GHOSTWALL_POPULAR_TOP=1000000

# ---- Block with your DNS server (docs/OPERATIONS.md, "Block with your DNS server") ----
# Ghostwall can hand its threat feed to AdGuard Home or Pi-hole as a blocklist, so the DNS
# server refuses those names for every device. Ghostwall stays out of the DNS path.
# off (default) | dry-run (builds the list, reports what it would block, registers nothing)
# | on. Try dry-run first: sudo ghostwall blocking. Apply: sudo systemctl restart ghostwall-dnsblock
DNS_BLOCK_FEED=off
# Ad and tracker blocking with HaGeZi's Multi list: off | pro (recommended) | ultimate (breaks more).
# DNS blocking cannot stop ads served from the same domain as the content (YouTube, Twitch, ...).
DNS_BLOCK_ADS=off
# on: also HaGeZi's DoH/VPN/Tor/Proxy bypass list. It breaks VPN apps and apps with their own
# encrypted DNS on purpose, so devices cannot walk around your DNS server.
DNS_BLOCK_BYPASS=off
# With DNS_BLOCK_FEED=on: use-application-dns.net (Firefox then turns its own DoH off) and
# iCloud Private Relay (mask.icloud.com, mask-h2.icloud.com) answer NXDOMAIN so those devices use
# your DNS. Private Relay then stops working on this network, which is the point. no-relay keeps
# Private Relay; off skips all three.
DNS_BLOCK_CANARIES=on
# How Ghostwall reaches the DNS server's API (the web UI's address and a login). AdGuard Home: its
# admin address and the login you made in its setup. Pi-hole: its address and its web password or an
# app password. Used for that API only; never logged.
#ADGUARD_URL=http://127.0.0.1:3000
#ADGUARD_USER=
#ADGUARD_PASSWORD=
#PIHOLE_URL=http://127.0.0.1
#PIHOLE_PASSWORD=
# Where the DNS server fetches Ghostwall's list from (served by Ghostwall on 127.0.0.1:5382).
# Docker: set by compose.yaml. Change only if your DNS server runs elsewhere.
#DNS_BLOCK_BIND=127.0.0.1
#DNS_BLOCK_PORT=5382
#DNS_BLOCK_URL=http://127.0.0.1:5382/ghostwall-blocklist.txt
# Protective upstream (a trade-off, see the docs): off | quad9 | cloudflare. Sets the DNS server's
# upstream once, when this changes; "off" puts back what it was. Never changed unless you set it.
DNS_PROTECTIVE_UPSTREAM=off
# With DNS_BLOCK_FEED on or dry-run the feed grows: HaGeZi TIF medium (2 GB RAM or more, else
# mini), CERT Polska, OpenPhish. GHOSTWALL_FEED_SET=standard keeps the three original lists;
# GHOSTWALL_TIF=mini|medium forces the size.
#GHOSTWALL_FEED_SET=auto
#GHOSTWALL_TIF=
# abuse.ch ThreatFox needs a free key (https://auth.abuse.ch): paste the hostfile URL its
# export page shows you. The key is never logged or written to the feed file.
#THREATFOX_URL=
