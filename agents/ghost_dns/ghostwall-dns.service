[Unit]
Description=ghost-dns -- Ghostwall DNS resolver + control API (the decision core)
After=network-online.target
Wants=network-online.target
# AdGuard Home is the upstream; start after it if present.
After=AdGuardHome.service

[Service]
Type=simple
# Not root: ghost-dns reads every name your devices look up, so it runs as its own
# user. CAP_DAC_READ_SEARCH lets it read the DNS server's query log (AdGuard keeps
# it root-only) without owning anything; CAP_NET_BIND_SERVICE is for port 53 in
# inline mode. It can write only to /var/lib/ghostwall.
User=ghostwall
Group=ghostwall
WorkingDirectory=/opt/ghostwall/agents/ghost_dns
# /etc/ghostwall/ghost_dns.json picks shadow or inline mode (go_shadow.sh writes a
# shadow config). See docs/OPERATIONS.md before turning learning off; enforce=nft
# also needs CAP_NET_ADMIN, added with a drop-in described there.
ExecStart=/opt/ghostwall/.venv/bin/python app.py --config /etc/ghostwall/ghost_dns.json
# onnxruntime phones home by default (scoring.py sets this too)
Environment=ORT_DISABLE_TELEMETRY=1
# state.json, events.jsonl and the threat feed; the dashboard and bot read it as ghostwall
StateDirectory=ghostwall
StateDirectoryMode=0750
Restart=always
RestartSec=3
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
# read-only (not true): the query log may live under /home (AdGuard in Docker)
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027
# AF_NETLINK: the nft enforcement backend (gateway mode) talks to the kernel with it
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
