[Unit]
Description=Ghostwall threat feed update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ghostwall
WorkingDirectory=/opt/ghostwall/agents/ghost_dns
# A source that fails or looks wrong keeps its previous contents (see update_feed.py).
# GHOSTWALL_FEEDS in ghostwall.env (space-separated URLs) replaces the default lists;
# GHOSTWALL_FEED_POPULAR_TOP sets the popularity guard (Tranco top N, cached here too).
EnvironmentFile=-/etc/ghostwall/ghostwall.env
ExecStart=/opt/ghostwall/.venv/bin/python update_feed.py --out /var/lib/ghostwall/threat_feed.txt
# IP reputation for gateway mode (ghost-dns loads it into the firewall); its failure is not the feed's.
ExecStartPost=-/opt/ghostwall/.venv/bin/python update_ipfeed.py --out /var/lib/ghostwall/ip_blocklist.txt
StateDirectory=ghostwall
StateDirectoryMode=0750
# It downloads and parses files from the internet: no capabilities, no devices, only
# the network and its own output file.
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0022
