[Unit]
Description=Ghostwall Telegram alerts and /fw commands (fw_bot)
After=network-online.target ghostwall-dns.service
Wants=network-online.target

[Service]
Type=simple
User=ghostwall
WorkingDirectory=/opt/ghostwall/agents/fw_bot
# FW_BOT_TELEGRAM_TOKEN and FW_BOT_CALLBACK_SECRET (see fw_bot.env.example).
EnvironmentFile=/etc/ghostwall/fw_bot.env
# --commands also polls Telegram for /fw commands and alert buttons. Remove it if
# another process already polls this bot token (two pollers on one token conflict).
ExecStart=/opt/ghostwall/.venv/bin/python fw_bot.py --owner-file /etc/ghostwall/owner.json --labels /var/lib/ghostwall/labels.jsonl --digest /var/lib/ghostwall/digest.jsonl --follow /var/lib/ghostwall/events.jsonl --commands
StateDirectory=ghostwall
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# Needs no capabilities and no devices; only the network and its own files.
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027

[Install]
WantedBy=multi-user.target
