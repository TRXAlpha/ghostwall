# Copy to /etc/ghostwall/fw_bot.env, then: chown root:ghostwall fw_bot.env; chmod 640 fw_bot.env
# Bot token from @BotFather.
FW_BOT_TELEGRAM_TOKEN=123456:replace-me
# Signs the alert buttons. Generate with:  openssl rand -hex 32
FW_BOT_CALLBACK_SECRET=replace-with-64-hex-chars
# minimal: messages name the device and the kind of alert, never a domain, IP or MAC
# (Telegram's servers see every message). Details stay on the dashboard.
#FW_BOT_PRIVACY=minimal
# tighten: Telegram can alert, show status, isolate and lock down, but cannot release a
# device, trust or unblock a domain, or switch lockdown or blocking off. Those then need the
# dashboard or the ghostwall command on the box. Recommended once auto_isolate or contain is on.
#FW_BOT_ACTIONS=tighten
