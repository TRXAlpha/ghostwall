#!/usr/sbin/nft -f
# ghostwall nftables ruleset — table "ghostwall" only.
# This file NEVER flushes other tables: Docker's and Tailscale's tables
# coexist untouched. Generated from templates/nftables-ghostwall.conf.j2.
# Validate (dry run) before applying:  nft -c -f ghostwall.nft
# Apply:                               sudo nft -f ghostwall.nft

# Idempotent reload of OUR table only (nftables 1.0.6 on Debian 12 / Raspberry Pi OS has no
# "destroy" command, which arrived in 1.0.8). Declaring the table first makes the delete safe.
table inet ghostwall {}
delete table inet ghostwall

table inet ghostwall {

    # ---------- flowtable: hardware/fast-path offload for ESTABLISHED flows ----------
    flowtable f {
        hook ingress priority filter
        devices = { {{ lan_iface }} }
    }

    # ---------- named sets ----------
    # Blackholed IPs: dropped in BOTH directions (to them and from them), for forwarded
    # traffic and for this box itself. ghost-dns fills it for contained destinations
    # (config "contain"), ghost-flow for a blocked beacon.
    # timeout flag: entries carry a per-element expiry and self-clean.
    # Starter list is EMPTY: populate via
    #   nft add element inet ghostwall blocked_ip { 1.2.3.4 timeout 24h }
    # (nftables does not accept an empty `elements` block, so the line is
    # omitted entirely when there are no elements.)
    set blocked_ip {
        type ipv4_addr
        flags timeout
    }

    # Devices in "strict" / lockdown: ALL their forwarded traffic is dropped
    # except DNS to the Pi and Tailscale exit.
    set isolated_dev {
        type ipv4_addr
    }

    # Public DNS resolvers' own addresses (DoH on 443, DoT/DoQ on 853): rendered from
    # agents/netconf/doh_ips.txt, the list ghost-flow's doh_ip alert uses too. Only addresses
    # dedicated to DNS (a shared CDN address would break websites). A device that has DoH by
    # NAME is stopped at DNS instead (the bypass list in AdGuard / Pi-hole).
    # IPv4 and IPv6 are separate sets (an ipv4_addr set cannot hold IPv6 addresses).
    set doh_ip4 {
        type ipv4_addr
        flags interval
        elements = {
{{ doh_ip4_elements }}
        }
    }

    # IP reputation (Spamhaus DROP, abuse.ch botnet C2): filled at runtime by ghost-dns from
    # /var/lib/ghostwall/ip_blocklist.txt (update_ipfeed.py, daily). Empty until then.
    set drop_net4 {
        type ipv4_addr
        flags interval
        auto-merge
    }

    set drop_net6 {
        type ipv6_addr
        flags interval
        auto-merge
    }

    # Devices marked "profile": "iot" in devices.json (the egress lock, when on, applies to them).
    set iot_dev {
        type ipv4_addr
{{ iot_dev_elements }}
    }

    # Named devices (devices.json) and the MAC each one has: config.json "antispoof" drops
    # LAN packets that carry a named device's address from any other MAC.
    set named_dev {
        type ipv4_addr
{{ named_dev_elements }}
    }

    set named_mac {
        type ipv4_addr . ether_addr
{{ named_mac_elements }}
    }

    set doh_ip6 {
        type ipv6_addr
        flags interval
        elements = {
{{ doh_ip6_elements }}
        }
    }

    # ---------- input chain ----------
    chain input {
        type filter hook input priority filter; policy {{ input_policy }};

        iifname "lo" accept

        # --- blocked and criminal networks never reach this box either (inbound) ---
        ip saddr @blocked_ip counter drop
        ip saddr @drop_net4 counter drop
        ip6 saddr @drop_net6 counter drop

        # --- anti-spoofing for what is sent to this box too (config.json "antispoof"): a
        # DNS lookup under another device's address would be counted against that device ---
{{ antispoof_rule }}

        # --- an isolated device gets a trickle of DNS, enough to see what it keeps asking
        # for, too little to carry data out through lookups ---
        ip saddr @isolated_dev meta l4proto { tcp, udp } th dport 53 limit rate over 20/minute burst 20 packets counter drop

        # SSH: LAN and tailscale0 only
        iifname "{{ lan_iface }}" ip saddr {{ lan_cidr }} tcp dport 22 ct state new accept
        iifname "tailscale0" tcp dport 22 accept

        # DNS to us (the Pi is the LAN's resolver): LAN only
        iifname "{{ lan_iface }}" ip saddr {{ lan_cidr }} udp dport 53 accept
        iifname "{{ lan_iface }}" ip saddr {{ lan_cidr }} tcp dport 53 accept
        iifname "tailscale0" udp dport 53 accept
        iifname "tailscale0" tcp dport 53 accept

        # DHCP from LAN clients
        iifname "{{ lan_iface }}" udp dport 67 accept

        # Web interfaces on this box (config.json "lan_services_tcp": AdGuard Home's UI and
        # the Ghostwall dashboard by default): LAN and tailnet only
{{ input_rules }}

        # ICMP (ping, path-mtu, etc.)
        ip protocol icmp accept
        meta l4proto ipv6-icmp accept

        ct state established,related accept

        # config.json "input_policy": "accept" (default: the box stays reachable whatever
        # runs on it) or "drop" (only what is accepted above gets in: SSH, DNS, DHCP, the
        # listed web interfaces, ping, and replies).
    }

    # ---------- forward chain ----------
    chain forward {
        type filter hook forward priority filter; policy accept;

        # --- anti-spoofing (config.json "antispoof"): before the fast path, so a borrowed
        # address never gets a flow of its own ---
{{ antispoof_rule }}

        # --- flow offload for established flows (fast path) ---
        ct state established,related flow add @f

        # --- isolation: strict-profile devices ---
        # They may only do DNS to the Pi and reach the tailnet.
        ip daddr @isolated_dev ip daddr != {{ pi_ip }} drop
        # (the tailnet may reach an isolated device, to look at it; it may not start
        # connections into the tailnet)
        iifname "{{ lan_iface }}" ip saddr @isolated_dev ip daddr 100.64.0.0/10 ct state new counter drop
        iifname "{{ lan_iface }}" ip saddr @isolated_dev ip daddr != {{ pi_ip }} ip daddr != 100.64.0.0/10 drop

        # --- blocked destinations (any device), both directions ---
        ip daddr @blocked_ip counter drop
        ip saddr @blocked_ip counter drop
        ip daddr @doh_ip4 udp dport 443 drop
        ip daddr @doh_ip4 tcp dport 443 drop
        ip6 daddr @doh_ip6 udp dport 443 drop
        ip6 daddr @doh_ip6 tcp dport 443 drop

        # --- block DoT (DNS over TLS) on all forwarded traffic ---
        tcp dport 853 drop
        udp dport 853 drop

        # --- IP reputation: no LAN device talks to criminal networks or botnet C2 ---
        iifname "{{ lan_iface }}" ip daddr @drop_net4 counter drop
        iifname "{{ lan_iface }}" ip6 daddr @drop_net6 counter drop
        # ...and nothing from them is forwarded in (only when this box is on the return path;
        # with the router doing NAT, an unanswered outbound packet already means no session)
        ip saddr @drop_net4 counter drop
        ip6 saddr @drop_net6 counter drop

        # --- egress policy: ports no home device needs toward the internet, and (opt-in)
        # IoT devices limited to web / MQTT-TLS / time. From config.json via gen.py.
{{ egress_rules }}

        # (LAN DNS is forced to the Pi in chain prerouting_nat below: a redirect is
        # only allowed in a nat chain, and in a filter chain it made the whole
        # file fail to load. Hardcoded DoT is dropped above: port 853.)

        # --- LOCKDOWN SWITCH ---
        # To enter lockdown:  nft add rule inet ghostwall forward position 0 \
        #   iifname != "tailscale0" ip daddr != {{ pi_ip }} ip saddr != {{ pi_ip }} drop
        # To exit:            nft -a list chain inet ghostwall forward   (find handle) then
        #                     nft delete rule inet ghostwall forward handle <N>
        # Everything dropped except: tailnet traffic, and anything to/from the Pi itself.
        # The rules below stay commented out so lockdown is opt-in:
        # iifname != "tailscale0" ip daddr != {{ pi_ip }} ip saddr != {{ pi_ip }} drop

        # --- NFQUEUE hook slot for first-packet AI inspection ---
        # Reserved for the "ai_firewall" userspace inspector (ghostwall v2).
        # Enable later with:
        #   nft add rule inet ghostwall forward \
        #       iifname "{{ lan_iface }}" ct state new \
        #       meta l4proto { tcp, udp } th dport != 53 \
        #       queue num 100 bypass
        # The `bypass` (queue ... bypass) flag means: if no userspace listener
        # is bound to queue 100, packets just continue through the normal
        # rules — firewall behaviour is IDENTICAL with or without the AI
        # daemon running. We deliberately leave this disabled until the
        # inspector service exists.
        # queue num 100 bypass

        # Everything else: forward (the router does NAT; we do NOT masquerade
        # LAN traffic — the router's own NAT handles internet egress).
    }

    # ---------- output chain: this box does not talk to them either ----------
    chain output {
        type filter hook output priority filter; policy accept;
        oifname "lo" accept
        ip daddr @blocked_ip counter drop
        ip daddr @drop_net4 counter drop
        ip6 daddr @drop_net6 counter drop
    }

    # ---------- force LAN DNS to the Pi ----------
    # Any LAN client's port-53 query, to whatever server, is answered by the Pi.
    chain prerouting_nat {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "{{ lan_iface }}" ip saddr != {{ pi_ip }} udp dport 53 redirect to :53
        iifname "{{ lan_iface }}" ip saddr != {{ pi_ip }} tcp dport 53 redirect to :53
    }
}
