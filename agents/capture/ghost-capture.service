[Unit]
Description=ghostwall per-device rolling packet capture (capture_mgr)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# WorkingDirectory and ExecStart paths: adjust to where this repo lives on the Pi.
WorkingDirectory=/opt/ghostwall/capture
# capture_conf.json next to capture_mgr.py sets the interface (default eth0) and limits.
ExecStart=/usr/bin/python3 /opt/ghostwall/capture/capture_mgr.py serve --devices /opt/ghostwall/capture/devices.json --ring-dir /run/ghostwall/cap
Restart=on-failure
RestartSec=5
# The ring must be on tmpfs (the manager refuses to start otherwise). /run is tmpfs, and
# systemd creates this folder at start and removes it at stop; total_ring_mb caps its size.
RuntimeDirectory=ghostwall/cap
RuntimeDirectoryMode=0750
# '+': runs with full privileges, as the bounding set below can't create it otherwise.
ExecStartPre=+/bin/mkdir -p /var/lib/ghostwall/incidents
ExecStop=/bin/kill -INT $MAINPID
TimeoutStopSec=15
# tcpdump needs raw capture permissions; restrict everything else.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/ghostwall/cap /var/lib/ghostwall/incidents
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
