[Unit]
Description=ghostwall per-device rolling packet capture (capture_mgr)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ghostwall/agents/capture
# /etc/ghostwall/capture.json sets the interface (default eth0) and limits; the devices
# are the same file ghost-dns uses.
ExecStart=/usr/bin/python3 /opt/ghostwall/agents/capture/capture_mgr.py serve --devices /etc/ghostwall/devices.json --ring-dir /run/ghostwall/cap
Restart=on-failure
RestartSec=5
# The ring must be on tmpfs (the manager refuses to start otherwise). /run is tmpfs, and
# systemd creates this folder at start and removes it at stop; total_ring_mb caps its size.
RuntimeDirectory=ghostwall/cap
RuntimeDirectoryMode=0750
# '+': runs with full privileges, as the bounding set below can't create it otherwise.
ExecStartPre=+/bin/mkdir -p /var/lib/ghostwall/incidents
ExecStop=/bin/kill -INT $MAINPID
TimeoutStopSec=15
# tcpdump needs raw capture permissions; restrict everything else.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/ghostwall/cap /var/lib/ghostwall/incidents
PrivateTmp=yes
# Still root (see above), but nothing here needs home folders, kernel settings or namespaces,
# and the socket families are only the ones tcpdump and libpcap use (packet, netlink, inet, unix).
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_PACKET AF_NETLINK AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
# captured packets are private: new files are not readable by other users (no world bit)
UMask=0027

[Install]
WantedBy=multi-user.target
