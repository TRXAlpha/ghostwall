{
  "entropy_threshold": 3.5,
  "long_query_length": 60,
  "burst_threshold": 12,
  "burst_window_seconds": 30,
  "model_type": "statistical",
  "decision_threshold": 0.7,
  "learning_rate": 0.1,
  "zscore_threshold": 2.5,
  "auto_promote_after": 3,
  "auto_promote_decay_days": 30,
  "rare_tlds": ["zip", "top", "xyz", "gq", "work", "click", "cam", "link"],
  "common_tlds": ["com", "net", "org", "edu", "gov", "io", "app", "local"],
  "device_anomaly_score": 0.65,
  "trm_weights": {
    "entropy": 0.35,
    "length": 0.2,
    "rare_tld": 0.15,
    "burst": 0.2,
    "new_tld": 0.1
  },
  "dns_listen_host": "127.0.0.1",
  "dns_listen_port": 53,
  "dns_upstream": "1.1.1.1",
  "dns_timeout_seconds": 2.0,
  "dns_block_response": "nxdomain",
  "enforce_dns": true,
  "guard_log_path": "dns_guard.log",
  "blocklist_path": "blocklist.txt",
  "enforce_hosts": false,
  "hosts_path": "C:\\Windows\\System32\\drivers\\etc\\hosts",
  "firewall_rule_prefix": "AI-FW Block",
  "defender_scan": true
}
